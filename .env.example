# Скопировать в .env, заполнить BOT_TOKEN, chmod 600 .env.
# Раскомментированные строки — обязательные. Закомментированные = дефолты,
# раскомментируй только для переопределения.

# --- обязательное ---
BOT_TOKEN=

# --- хранилище ---
# DB_PATH=/opt/bgpwatch/bgpwatch.db

# --- цикл мониторинга ---
# POLL_INTERVAL=900           # период проверки, сек (15 мин)
# DEFAULT_PORT=22             # порт TCP-пробы по умолчанию
# PROBE_TIMEOUT=4             # таймаут одной TCP-пробы, сек
# PROBE_CONCURRENCY=100       # макс. параллельных проб

# --- BGP / RIPEstat ---
# BGP_UP_THRESHOLD=0.5        # доля RIS-пиров для статуса "up"
# BGP_CONCURRENCY=5           # параллельных BGP-запросов (RIPEstat лимит 8)
# RIPE_SOURCEAPP=bgpwatchrobot
# RIPE_TIMEOUT=25             # таймаут BGP-запроса, сек
# RIPE_RETRIES=3              # ретраи при http=000/429

# --- лимиты (защита публичного бота) ---
# MAX_WATCHES_PER_CHAT=50     # макс. подписок на чат
# MAX_PREFIXES_PER_CYCLE=500  # потолок уникальных префиксов за цикл
# RATE_LIMIT_CMDS=20          # макс. команд за окно на чат
# RATE_LIMIT_WINDOW=60        # окно rate-limit, сек
# RATE_LIMIT_MAX_CHATS=10000  # порог GC словаря rate-limit
# UNLIMITED_IDS=123456789     # chat_id без лимитов и rate-limit (через запятую)

# --- Telegram IP-пиннинг (обход блокировки api.telegram.org) ---
# TELEGRAM_API_IPS=149.154.167.220
# TELEGRAM_DISCOVER_RANGES=149.154.167.0/24,149.154.166.0/24,149.154.175.0/24,91.108.56.0/24,91.108.4.0/24
# TELEGRAM_IP_STATE=/opt/bgpwatch/telegram_ip.txt
